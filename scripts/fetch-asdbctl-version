#!/usr/bin/env bash
# Fetches the latest stable asdbctl version and source-tarball SHA256.
# Outputs KEY=VALUE lines suitable for $GITHUB_OUTPUT or shell consumption.
set -euo pipefail

VERSION=$(curl -sf "https://api.github.com/repos/juliuszint/asdbctl/releases/latest" \
  | jq -r '.tag_name | ltrimstr("v")')

SHA256=$(curl -sfL "https://github.com/juliuszint/asdbctl/archive/refs/tags/v${VERSION}.tar.gz" \
  | sha256sum | awk '{print $1}')

echo "VERSION=${VERSION}"
echo "SHA256=${SHA256}"
