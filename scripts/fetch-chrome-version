#!/usr/bin/env bash
# Fetches the latest stable Google Chrome version and per-arch SHA256s from
# Google's RPM repodata. Outputs KEY=VALUE lines suitable for $GITHUB_OUTPUT or
# shell consumption.
set -euo pipefail

REPO="https://dl.google.com/linux/chrome/rpm/stable"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

for ARCH in x86_64 aarch64; do
  curl -sf "${REPO}/${ARCH}/repodata/primary.xml.gz" | gunzip > "${TMP}/${ARCH}.xml"
done

python3 - "${TMP}/x86_64.xml" "${TMP}/aarch64.xml" <<'PY'
import sys, xml.etree.ElementTree as ET

ns = {'r': 'http://linux.duke.edu/metadata/common'}

def stable(path):
    out = {}
    for pkg in ET.parse(path).getroot().findall('r:package', ns):
        if pkg.find('r:name', ns).text == 'google-chrome-stable':
            out[pkg.find('r:version', ns).get('ver')] = pkg.find('r:checksum', ns).text
    return out

x86, arm = stable(sys.argv[1]), stable(sys.argv[2])
# Only versions published for both arches can go in the cask.
common = set(x86) & set(arm)
if not common:
    print('no google-chrome-stable version present for both arches', file=sys.stderr)
    sys.exit(1)

ver = max(common, key=lambda v: tuple(int(x) for x in v.split('.')))
print(f'VERSION={ver}')
print(f'SHA256_ARM64={arm[ver]}')
print(f'SHA256_X86_64={x86[ver]}')
PY
