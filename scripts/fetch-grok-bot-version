#!/usr/bin/env bash
# Fetches the latest grok-bot version and SHA256s from the apt repository
# metadata. Outputs KEY=VALUE lines suitable for $GITHUB_OUTPUT or shell
# consumption.
set -euo pipefail

REPO="https://downloads.cursor.com/aptrepo"

# latest <arch>: "<version> <sha256>" of the newest grok-bot in that arch's Packages.
# Only plain X.Y.Z versions: skips betas and epochs.
latest() {
  curl -fsSL "${REPO}/dists/grok-bot/main/binary-$1/Packages" \
    | awk -v RS= '/(^|\n)Package: grok-bot\n/ {
        v = s = ""
        n = split($0, line, "\n")
        for (i = 1; i <= n; i++) {
          if (line[i] ~ /^Version: /) v = substr(line[i], 10)
          if (line[i] ~ /^SHA256: /) s = substr(line[i], 9)
        }
        if (v ~ /^[0-9]+(\.[0-9]+)+$/ && s != "") print v, s
      }' \
    | sort -V | tail -n 1
}

AMD64=$(latest amd64) || { echo "could not read the amd64 Packages file" >&2; exit 1; }
ARM64=$(latest arm64) || { echo "could not read the arm64 Packages file" >&2; exit 1; }
if [ -z "$AMD64" ] || [ -z "$ARM64" ]; then
  echo "no grok-bot release with a plain X.Y.Z version in apt Packages metadata" >&2
  exit 1
fi

read -r VERSION SHA256_X86_64 <<<"$AMD64"
read -r VERSION_ARM64 SHA256_ARM64 <<<"$ARM64"

if [ "$VERSION" != "$VERSION_ARM64" ]; then
  echo "amd64 is at $VERSION but arm64 is at $VERSION_ARM64; try again later." >&2
  exit 1
fi

echo "VERSION=${VERSION}"
echo "SHA256_ARM64=${SHA256_ARM64}"
echo "SHA256_X86_64=${SHA256_X86_64}"
