#!/usr/bin/env bash
# Updates the 1password-gui-linux cask to a new version+shas, verifying the tarball exists first.
# Usage: bump-1password-cask <version> <sha256_arm64> <sha256_x86_64>
set -euo pipefail

VERSION="${1:?usage: bump-1password-cask <version> <sha256_arm64> <sha256_x86_64>}"
SHA256_ARM64="${2:?usage: bump-1password-cask <version> <sha256_arm64> <sha256_x86_64>}"
SHA256_X86_64="${3:?usage: bump-1password-cask <version> <sha256_arm64> <sha256_x86_64>}"
CASK="Casks/1password-gui-linux.rb"

CURRENT=$(awk -F'"' '/^ *version "/{print $2}' "$CASK")
if [ "$VERSION" = "$CURRENT" ]; then
  echo "Already at $VERSION" >&2
  exit 0
fi

URL="https://downloads.1password.com/linux/tar/stable/x86_64/1password-${VERSION}.x64.tar.gz"
STATUS=$(curl -sILo /dev/null -w "%{http_code}" "$URL")
if [ "$STATUS" != "200" ]; then
  echo "Tarball not found at $URL (HTTP $STATUS)" >&2
  exit 1
fi

sed -i "s/version \".*\"/version \"${VERSION}\"/" "$CASK"
sed -i 's/\(arm64_linux: *"\)[^"]*"/\1'"${SHA256_ARM64}"'"/' "$CASK"
sed -i 's/\(x86_64_linux: *"\)[^"]*"/\1'"${SHA256_X86_64}"'"/' "$CASK"

echo "CHANGED=true"
echo "$CURRENT -> $VERSION" >&2
