#!/usr/bin/env bash
# Updates the asdbctl cask to a new version+sha, verifying the tarball exists first.
# Usage: bump-asdbctl-cask <version> <sha256>
set -euo pipefail

VERSION="${1:?usage: bump-asdbctl-cask <version> <sha256>}"
SHA256="${2:?usage: bump-asdbctl-cask <version> <sha256>}"
CASK="Casks/asdbctl.rb"

CURRENT=$(awk -F'"' '/^ *version "/{print $2}' "$CASK")
if [ "$VERSION" = "$CURRENT" ]; then
  echo "Already at $VERSION" >&2
  exit 0
fi

URL="https://github.com/juliuszint/asdbctl/archive/refs/tags/v${VERSION}.tar.gz"
STATUS=$(curl -sILo /dev/null -w "%{http_code}" -L "$URL")
if [ "$STATUS" != "200" ]; then
  echo "Tarball not found at $URL (HTTP $STATUS)" >&2
  exit 1
fi

sed -i "s/version \".*\"/version \"${VERSION}\"/" "$CASK"
sed -i "s/sha256 \".*\"/sha256 \"${SHA256}\"/" "$CASK"

echo "CHANGED=true"
echo "$CURRENT -> $VERSION" >&2
