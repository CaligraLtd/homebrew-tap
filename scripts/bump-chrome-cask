#!/usr/bin/env bash
# Updates the google-chrome-linux cask to a new version+shas, verifying both RPMs exist first.
# Usage: bump-chrome-cask <version> <sha256_arm64> <sha256_x86_64>
set -euo pipefail

VERSION="${1:?usage: bump-chrome-cask <version> <sha256_arm64> <sha256_x86_64>}"
SHA256_ARM64="${2:?usage: bump-chrome-cask <version> <sha256_arm64> <sha256_x86_64>}"
SHA256_X86_64="${3:?usage: bump-chrome-cask <version> <sha256_arm64> <sha256_x86_64>}"
CASK="Casks/google-chrome-linux.rb"

CURRENT=$(awk -F'"' '/^ *version "/{print $2}' "$CASK")
if [ "$VERSION" = "$CURRENT" ]; then
  echo "Already at $VERSION" >&2
  exit 0
fi

# No -f so curl doesn't exit non-zero on 4xx
for ARCH in aarch64 x86_64; do
  URL="https://dl.google.com/linux/chrome/rpm/stable/${ARCH}/google-chrome-stable-${VERSION}-1.${ARCH}.rpm"
  STATUS=$(curl -sIo /dev/null -w "%{http_code}" "$URL")
  if [ "$STATUS" != "200" ]; then
    echo "RPM not found at $URL (HTTP $STATUS)" >&2
    exit 1
  fi
done

sed -i "s/version \".*\"/version \"${VERSION}\"/" "$CASK"
sed -i 's/\(arm64_linux: *"\)[^"]*"/\1'"${SHA256_ARM64}"'"/' "$CASK"
sed -i 's/\(x86_64_linux: *"\)[^"]*"/\1'"${SHA256_X86_64}"'"/' "$CASK"

echo "CHANGED=true"
echo "$CURRENT -> $VERSION" >&2
