#!/usr/bin/env bash
# Fetches the latest stable Zed version and SHA256s from the GitHub releases API.
# Outputs KEY=VALUE lines suitable for $GITHUB_OUTPUT or shell consumption.
set -euo pipefail

curl -sf "https://api.github.com/repos/zed-industries/zed/releases/latest" \
  | python3 -c "
import sys, json

data = json.load(sys.stdin)
version = data['tag_name'].lstrip('v')
sha_arm64 = sha_x86_64 = None

for asset in data['assets']:
    name = asset['name']
    digest = asset.get('digest', '')
    if name == 'zed-linux-aarch64.tar.gz':
        sha_arm64 = digest.removeprefix('sha256:')
    elif name == 'zed-linux-x86_64.tar.gz':
        sha_x86_64 = digest.removeprefix('sha256:')

if not sha_arm64 or not sha_x86_64:
    print('Could not find Linux assets in release', file=sys.stderr)
    sys.exit(1)

print(f'VERSION={version}')
print(f'SHA256_ARM64={sha_arm64}')
print(f'SHA256_X86_64={sha_x86_64}')
"
