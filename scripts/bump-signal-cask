#!/usr/bin/env bash
# Updates the signal-desktop-linux cask to a new version+sha, verifying the .deb
# exists first.
# Usage: bump-signal-cask <version> <sha256>
set -euo pipefail

VERSION="${1:?usage: bump-signal-cask <version> <sha256>}"
SHA256="${2:?usage: bump-signal-cask <version> <sha256>}"
CASK="Casks/signal-desktop-linux.rb"

CURRENT=$(awk -F'"' '/^ *version "/{print $2}' "$CASK")
if [ "$VERSION" = "$CURRENT" ]; then
  echo "Already at $VERSION" >&2
  exit 0
fi

# Verify the versioned .deb actually exists (no -f so curl doesn't exit non-zero on 4xx)
URL="https://updates.signal.org/desktop/apt/pool/s/signal-desktop/signal-desktop_${VERSION}_amd64.deb"
STATUS=$(curl -sILo /dev/null -w "%{http_code}" "$URL")
if [ "$STATUS" != "200" ]; then
  echo ".deb not found at $URL (HTTP $STATUS)" >&2
  exit 1
fi

sed -i "s/version \".*\"/version \"${VERSION}\"/" "$CASK"
sed -i "s/sha256 \".*\"/sha256 \"${SHA256}\"/" "$CASK"

echo "CHANGED=true"
echo "$CURRENT -> $VERSION" >&2
