#!/usr/bin/env bash
# Fetches the latest stable 1Password version and SHA256s from the release feed.
# Outputs KEY=VALUE lines suitable for $GITHUB_OUTPUT or shell consumption.
set -euo pipefail

VERSION=$(curl -sf "https://releases.1password.com/linux/stable/index.xml" \
  | python3 -c "
import sys, re, xml.etree.ElementTree as ET

tree = ET.parse(sys.stdin)
regex = re.compile(r'v?(\d+(?:\.\d+)+)')
best = None
for link in tree.getroot().iter('link'):
    m = regex.search(link.text or '')
    if m:
        ver = m.group(1)
        ver_tuple = tuple(int(x) for x in ver.split('.'))
        if best is None or ver_tuple > best[0]:
            best = (ver_tuple, ver)

if best is None:
    print('No version found in feed', file=sys.stderr)
    sys.exit(1)

print(best[1])
")

SHA256_ARM64=$(curl -sfL "https://downloads.1password.com/linux/tar/stable/aarch64/1password-${VERSION}.arm64.tar.gz" \
  | sha256sum | awk '{print $1}')

SHA256_X86_64=$(curl -sfL "https://downloads.1password.com/linux/tar/stable/x86_64/1password-${VERSION}.x64.tar.gz" \
  | sha256sum | awk '{print $1}')

echo "VERSION=${VERSION}"
echo "SHA256_ARM64=${SHA256_ARM64}"
echo "SHA256_X86_64=${SHA256_X86_64}"
