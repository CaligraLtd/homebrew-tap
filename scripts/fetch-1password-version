#!/usr/bin/env bash
# Fetches the latest stable 1Password version and SHA256s from the release feed,
# verifying each tarball against 1Password's published OpenPGP signature before
# trusting the sha. Outputs KEY=VALUE lines suitable for $GITHUB_OUTPUT or
# shell consumption.
set -euo pipefail

EXPECTED_FPR="3FEF9748469ADBE15DA7CA80AC2D62742012EA22"
KEY_URL="https://downloads.1password.com/linux/keys/1password.asc"

VERSION=$(curl -sf "https://releases.1password.com/linux/stable/index.xml" \
  | python3 -c "
import sys, re, xml.etree.ElementTree as ET

tree = ET.parse(sys.stdin)
regex = re.compile(r'v?(\d+(?:\.\d+)+)')
best = None
for link in tree.getroot().iter('link'):
    m = regex.search(link.text or '')
    if m:
        ver = m.group(1)
        ver_tuple = tuple(int(x) for x in ver.split('.'))
        if best is None or ver_tuple > best[0]:
            best = (ver_tuple, ver)

if best is None:
    print('No version found in feed', file=sys.stderr)
    sys.exit(1)

print(best[1])
")

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT
GNUPGHOME="$WORKDIR/gnupg"
mkdir -m 700 "$GNUPGHOME"
export GNUPGHOME

curl -sSfL "$KEY_URL" | gpg --quiet --import
IMPORTED_FPR=$(gpg --with-colons --fingerprint | awk -F: '/^fpr/{print $10; exit}')
if [ "$IMPORTED_FPR" != "$EXPECTED_FPR" ]; then
  echo "1Password key fingerprint mismatch: got $IMPORTED_FPR, expected $EXPECTED_FPR" >&2
  exit 1
fi

sha_of_signed_tarball() {
  local url="$1"
  local name="$2"
  local tar="$WORKDIR/$name.tar.gz"
  local sig="$WORKDIR/$name.tar.gz.sig"
  local verify_log="$WORKDIR/$name.verify.log"
  curl -sSfL "$url"     -o "$tar"
  curl -sSfL "$url.sig" -o "$sig"
  if ! gpg --quiet --verify "$sig" "$tar" 2>"$verify_log"; then
    cat "$verify_log" >&2
    echo "Signature verification failed for $url" >&2
    exit 1
  fi
  sha256sum "$tar" | awk '{print $1}'
}

SHA256_ARM64=$(sha_of_signed_tarball \
  "https://downloads.1password.com/linux/tar/stable/aarch64/1password-${VERSION}.arm64.tar.gz" \
  arm64)

SHA256_X86_64=$(sha_of_signed_tarball \
  "https://downloads.1password.com/linux/tar/stable/x86_64/1password-${VERSION}.x64.tar.gz" \
  x86_64)

echo "VERSION=${VERSION}"
echo "SHA256_ARM64=${SHA256_ARM64}"
echo "SHA256_X86_64=${SHA256_X86_64}"
