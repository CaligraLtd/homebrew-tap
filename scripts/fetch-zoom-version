#!/usr/bin/env bash
# Fetches the latest Zoom Workplace for Linux version and its SHA256. Outputs
# KEY=VALUE lines suitable for $GITHUB_OUTPUT or shell consumption.
#
# Zoom publishes no checksums and no repository metadata, so the RPM has
# to be downloaded and hashed.
#
# Requires rpmkeys, from the rpm package, and gpg.
set -euo pipefail

# Zoom Communications, Inc. <CryptoOpsCodeSignProd@zoom.us>, served from
# https://zoom.us/linux/download/pubkey. The script will fail if Zoom rotates the key.
KEY_FINGERPRINT="84c365d6cc9a4886ca926bcc4f2197399706ac24"

for tool in rpmkeys gpg; do
  command -v "$tool" >/dev/null || {
    echo "$tool is required to verify the Zoom package signature" >&2
    exit 1
  }
done

VERSION=$(curl -fsSL "https://zoom.us/rest/download?os=linux" |
  jq -er '.result.downloadVO.zoom.version') || {
  echo "no Linux client version in Zoom download API response" >&2
  exit 1
}

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

RPM="${WORKDIR}/zoom_x86_64.rpm"
curl -fsSL "https://cdn.zoom.us/prod/${VERSION}/zoom_x86_64.rpm" -o "$RPM"
curl -fsSL "https://zoom.us/linux/download/pubkey" -o "${WORKDIR}/pubkey.asc"

# rpm only names the short key ID in its output before 6.0, so the pin lives
# here: the keyring seeded into the throwaway rpmdb must hold the pinned key and
# nothing else. Subkey fingerprints are skipped, only the primary key is pinned.
PRIMARY_FINGERPRINT=$(gpg --show-keys --with-colons "${WORKDIR}/pubkey.asc" 2>/dev/null |
  awk -F: '$1 == "pub" { p = 1 } $1 == "fpr" && p { print tolower($10); p = 0 }') || true

if [ "$PRIMARY_FINGERPRINT" != "$KEY_FINGERPRINT" ]; then
  echo "zoom pubkey is ${PRIMARY_FINGERPRINT:-unreadable}, expected ${KEY_FINGERPRINT}" >&2
  exit 1
fi

rpm --dbpath "${WORKDIR}/rpmdb" --initdb
rpmkeys --dbpath "${WORKDIR}/rpmdb" --import "${WORKDIR}/pubkey.asc"

# Non-zero covers both the digests and an unknown signing key (NOKEY). The grep
# is belt and braces; rpm 4.x prints the key ID, rpm 6.x the full fingerprint.
CHECKSIG=$(rpmkeys --dbpath "${WORKDIR}/rpmdb" --checksig -v "$RPM" 2>&1) || {
  echo "signature check failed for zoom_x86_64.rpm ${VERSION}:" >&2
  echo "$CHECKSIG" >&2
  exit 1
}

if ! grep -qiE "key (id ${KEY_FINGERPRINT: -8}|fingerprint: ${KEY_FINGERPRINT}): OK" <<<"$CHECKSIG"; then
  echo "zoom_x86_64.rpm ${VERSION} is not signed by ${KEY_FINGERPRINT}:" >&2
  echo "$CHECKSIG" >&2
  exit 1
fi

SHA256=$(sha256sum "$RPM" | awk '{print $1}')

echo "VERSION=${VERSION}"
echo "SHA256=${SHA256}"
