#!/usr/bin/env bash
# Updates the pycharm-linux cask to a new version+shas, verifying the tarball exists first.
# Usage: bump-pycharm-cask <version> <build> <sha256_arm64> <sha256_x86_64>
set -euo pipefail

VERSION="${1:?usage: bump-pycharm-cask <version> <build> <sha256_arm64> <sha256_x86_64>}"
BUILD="${2:?usage: bump-pycharm-cask <version> <build> <sha256_arm64> <sha256_x86_64>}"
SHA256_ARM64="${3:?usage: bump-pycharm-cask <version> <build> <sha256_arm64> <sha256_x86_64>}"
SHA256_X86_64="${4:?usage: bump-pycharm-cask <version> <build> <sha256_arm64> <sha256_x86_64>}"
CASK="Casks/pycharm-linux.rb"

CURRENT=$(awk -F'"' '/^ *version "/{print $2}' "$CASK")
if [ "${VERSION},${BUILD}" = "$CURRENT" ]; then
  echo "Already at ${VERSION},${BUILD}" >&2
  exit 0
fi

URL="https://download.jetbrains.com/python/pycharm-${VERSION}.tar.gz"
STATUS=$(curl -sILo /dev/null -w "%{http_code}" "$URL")
if [ "$STATUS" != "200" ]; then
  echo "Tarball not found at $URL (HTTP $STATUS)" >&2
  exit 1
fi

sed -i "s/version \".*\"/version \"${VERSION},${BUILD}\"/" "$CASK"
sed -i 's/\(arm64_linux: *"\)[^"]*"/\1'"${SHA256_ARM64}"'"/' "$CASK"
sed -i 's/\(x86_64_linux: *"\)[^"]*"/\1'"${SHA256_X86_64}"'"/' "$CASK"

echo "CHANGED=true"
echo "${CURRENT} -> ${VERSION},${BUILD}" >&2
