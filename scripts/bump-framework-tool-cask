#!/usr/bin/env bash
# Updates the framework-tool cask to a new version+sha, verifying the binary exists first.
# Usage: bump-framework-tool-cask <version> <sha256>
set -euo pipefail

VERSION="${1:?usage: bump-framework-tool-cask <version> <sha256>}"
SHA256="${2:?usage: bump-framework-tool-cask <version> <sha256>}"
CASK="Casks/framework-tool.rb"

CURRENT=$(awk -F'"' '/^ *version "/{print $2}' "$CASK")
if [ "$VERSION" = "$CURRENT" ]; then
  echo "Already at $VERSION" >&2
  exit 0
fi

URL="https://github.com/FrameworkComputer/framework-system/releases/download/v${VERSION}/framework_tool"
STATUS=$(curl -sILo /dev/null -w "%{http_code}" "$URL")
if [ "$STATUS" != "200" ]; then
  echo "Binary not found at $URL (HTTP $STATUS)" >&2
  exit 1
fi

sed -i "s/version \".*\"/version \"${VERSION}\"/" "$CASK"
sed -i "s/sha256 \".*\"/sha256 \"${SHA256}\"/" "$CASK"

echo "CHANGED=true"
echo "$CURRENT -> $VERSION" >&2
